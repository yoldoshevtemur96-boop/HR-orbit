// HR Orbit — asosiy ma'lumotlar bazasi sxemasi
// Multi-tenant: deyarli barcha jadvallar organizationId orqali ajratiladi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (pgbouncer) — runtime so'rovlar uchun
  directUrl = env("DIRECT_URL") // to'g'ridan-to'g'ri ulanish — migratsiyalar uchun
}

// ==========================================================================
// TENANT / ORGANIZATION
// ==========================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // subdomen: slug.hrorbit.uz
  plan      String   @default("trial") // trial | starter | pro
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  departments       Department[]
  branches          Branch[]
  positions         Position[]
  employees         Employee[]
  employmentRecords EmploymentRecord[]
  employeeEducations EmployeeEducation[]
  employeeDocuments EmployeeDocument[]
  workflowTemplates WorkflowTemplate[]
  workflowInstances WorkflowInstance[]
  auditLogs         AuditLog[]
  vacancies         Vacancy[]
  candidates        Candidate[]
  notifications     Notification[]
  attendanceRecords AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  timesheetCellEdits    TimesheetCellEdit[]
  departmentTimesheets DepartmentTimesheet[]
  organizationTimesheets OrganizationTimesheet[]
  attendanceSettings AttendanceSettings?

  @@map("organizations")
}

// ==========================================================================
// AUTH / USERS / ROLES
// ==========================================================================

enum RoleName {
  SUPER_ADMIN // tenant ichidagi to'liq huquq
  HR_MANAGER
  HR_SPECIALIST // Core HR: to'liq ko'rish + cheklangan tahrirlash (employment o'zgartira olmaydi)
  RECRUITER
  DEPARTMENT_HEAD
  EMPLOYEE
  TIMEKEEPER // "HR tabelchi" — Attendance modulini to'liq boshqaradi
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  role           RoleName @default(EMPLOYEE)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?

  initiatedWorkflows      WorkflowInstance[]   @relation("WorkflowInitiator")
  stepActions             WorkflowStepAction[]
  auditLogs               AuditLog[]
  employmentRecordChanges EmploymentRecord[]   @relation("EmploymentRecordChangedBy")
  uploadedDocuments       EmployeeDocument[]   @relation("DocumentUploadedBy")
  notifications           Notification[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// ==========================================================================
// CORE HR — spravochniklar (Department / Branch / Position)
// ==========================================================================

enum OrgUnitStatus {
  ACTIVE
  ARCHIVED
}

model Department {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  code           String
  parentId       String? // tashkiliy ierarxiya uchun o'z-o'ziga bog'lanish
  headEmployeeId String?       @unique // bo'lim boshlig'i
  status         OrgUnitStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DeptHierarchy")
  employees    Employee[]   @relation("DeptEmployees")
  headEmployee Employee?    @relation("DeptHead", fields: [headEmployeeId], references: [id])
  positions    Position[]
  employmentRecords EmploymentRecord[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Branch {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  code           String
  region         String?
  address        String?
  managerId      String?       @unique // filial rahbari (Employee)
  status         OrgUnitStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      Employee?    @relation("BranchManager", fields: [managerId], references: [id])
  employees    Employee[]   @relation("BranchEmployees")
  positions    Position[]
  employmentRecords EmploymentRecord[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Position {
  id                String        @id @default(cuid())
  organizationId    String
  departmentId      String
  branchId          String?
  name              String
  code              String
  grade             String?
  approvedHeadcount Int           @default(1)
  status            OrgUnitStatus @default(ACTIVE)
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  employees    Employee[]   @relation("PositionEmployees")
  employmentRecords EmploymentRecord[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("positions")
}

// ==========================================================================
// CORE HR — Employee (yagona haqiqat manbai)
// ==========================================================================

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  TERMINATED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
  CONTRACT
  REMOTE
  HYBRID
}

enum Gender {
  MALE
  FEMALE
}

model Employee {
  id             String  @id @default(cuid())
  organizationId String
  userId         String? @unique
  employeeCode   String // inson o'qiydigan ID, masalan "EMP-00001"

  // Shaxsiy ma'lumotlar
  firstName      String
  lastName       String
  middleName     String?
  fullName       String // firstName+lastName+middleName'dan generatsiya — tezkor qidiruv/sort uchun denormalized
  dateOfBirth    DateTime?
  gender         Gender?
  pinfl          String? // restricted — faqat SUPER_ADMIN/HR_MANAGER/HR_SPECIALIST ko'radi
  passportNumber String? // restricted

  // Aloqa
  personalPhone         String?
  workPhone             String?
  personalEmail         String?
  workEmail             String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Employment — joriy holat (denormalized, tezkor so'rov uchun; to'liq tarix EmploymentRecord'da)
  departmentId      String?
  branchId          String?
  positionId        String?
  managerId         String? // bevosita rahbar — workflow marshrutlash uchun ham muhim
  status            EmploymentStatus @default(ACTIVE)
  employmentType    EmploymentType?
  contractNumber    String?
  contractStartDate DateTime?
  contractEndDate   DateTime?
  workSchedule      String?
  workLocation      String?

  hiredAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  department   Department?  @relation("DeptEmployees", fields: [departmentId], references: [id])
  branch       Branch?      @relation("BranchEmployees", fields: [branchId], references: [id])
  position     Position?    @relation("PositionEmployees", fields: [positionId], references: [id])
  manager      Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports Employee[]  @relation("EmployeeManager")
  headOfDept   Department?  @relation("DeptHead")
  branchManagerOf Branch?   @relation("BranchManager")

  educations        EmployeeEducation[]
  documents         EmployeeDocument[]
  employmentHistory EmploymentRecord[]  @relation("EmploymentRecordEmployee")
  managedRecords    EmploymentRecord[]  @relation("EmploymentRecordManager")

  workflowInstances WorkflowInstance[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, pinfl])
  @@unique([organizationId, workEmail])
  @@index([organizationId])
  @@index([managerId])
  @@index([departmentId])
  @@index([branchId])
  @@index([positionId])
  @@map("employees")
}

// Har bir employment o'zgarishi (lavozim/bo'lim/filial/rahbar) yangi yozuv
// hosil qiladi — eski yozuv endDate bilan yopiladi. Hech qachon o'chirilmaydi.
model EmploymentRecord {
  id              String    @id @default(cuid())
  organizationId  String
  employeeId      String
  positionId      String?
  departmentId    String?
  branchId        String?
  managerId       String?
  startDate       DateTime
  endDate         DateTime? // null = joriy/ochiq yozuv
  reason          String?
  changedByUserId String?
  createdAt       DateTime  @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee      Employee     @relation("EmploymentRecordEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  position      Position?    @relation(fields: [positionId], references: [id])
  department    Department?  @relation(fields: [departmentId], references: [id])
  branch        Branch?      @relation(fields: [branchId], references: [id])
  manager       Employee?    @relation("EmploymentRecordManager", fields: [managerId], references: [id])
  changedByUser User?        @relation("EmploymentRecordChangedBy", fields: [changedByUserId], references: [id])

  @@index([organizationId])
  @@index([employeeId, startDate])
  @@map("employment_records")
}

model EmployeeEducation {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  level          String // masalan: "Bakalavr", "Magistr"
  institution    String
  specialty      String?
  graduationYear Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_education")
}

// Skeleton — bu bosqichda upload UI/storage yo'q, faqat jadval tayyor.
model EmployeeDocument {
  id                String   @id @default(cuid())
  organizationId    String
  employeeId        String
  name              String
  fileUrl           String
  uploadedByUserId  String?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedByUser User?      @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([employeeId])
  @@map("employee_documents")
}

// ==========================================================================
// WORKFLOW ENGINE — konstruktor + ijro
//
// Ariza turlari (Ta'til, Ma'lumotnoma, Xodimni ko'chirish va h.k.) shablon
// sifatida saqlanadi. Har bir shablon o'z bosqichlar zanjiriga ega —
// zanjirdagi har bir bosqich "kim tasdiqlaydi" degan qoidaga ega:
// aniq lavozim (masalan "Kadrlar bo'limi") yoki dinamik qoida
// (masalan "boshlovchining bevosita rahbari" — ApproverType.MANAGER).
// ==========================================================================

// Kim tasdiqlaydi — bosqich qoidasi
enum ApproverType {
  SPECIFIC_USER // aniq belgilangan shaxs (approverUserId)
  ROLE // aniq rol (masalan HR_MANAGER — tashkilotdagi barcha shu roldagilar emas, birinchi topilgani)
  DIRECT_MANAGER // arizachining bevosita rahbari (Employee.managerId)
  DEPARTMENT_HEAD // arizachi bo'limining boshlig'i
}

enum StepActionType {
  APPROVE // imzolash/tasdiqlash (rad etish mumkin)
  ACKNOWLEDGE // faqat xabardor bo'lish, bloklamaydi
}

// Ariza/hujjat shabloni — konstruktorda yaratiladi
model WorkflowTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String // masalan: "Mehnat ta'tiliga chiqish arizasi"
  description    String?
  isActive       Boolean  @default(true)
  formSchema     Json // dinamik forma maydonlari: [{key, label, type, required}, ...]
  documentBody   String? // hujjat/buyruq matni shabloni, {{maydon}} o'rin bosuvchilar bilan
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  instances    WorkflowInstance[]

  @@index([organizationId])
  @@map("workflow_templates")
}

// Zanjirdagi bitta bosqich — konstruktorda tartib bilan belgilanadi
model WorkflowStep {
  id             String         @id @default(cuid())
  templateId     String
  order          Int // 1, 2, 3... — zanjirdagi tartib
  name           String // masalan: "Bo'lim boshlig'i tasdig'i"
  approverType   ApproverType
  approverRole   RoleName? // approverType = ROLE bo'lsa
  approverUserId String? // approverType = SPECIFIC_USER bo'lsa
  actionType     StepActionType @default(APPROVE)

  template        WorkflowTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepExecutions  WorkflowStepAction[]

  @@unique([templateId, order])
  @@map("workflow_steps")
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  APPROVED // barcha bosqichlardan o'tdi
  REJECTED // kimdir rad etdi
  CANCELLED // arizachi bekor qildi
}

// Xodim tomonidan yuborilgan aniq ariza — shablon asosida yaratilgan instance
model WorkflowInstance {
  id               String                  @id @default(cuid())
  organizationId   String
  templateId       String
  initiatorUserId  String // arizani kim yubordi
  employeeId       String // qaysi xodimga tegishli (odatda initiator bilan bir xil)
  formData         Json // to'ldirilgan forma qiymatlari (masalan boshlanish sanasi, kun soni)
  generatedDocument String? // shablon + formData asosida generatsiya qilingan hujjat matni
  status           WorkflowInstanceStatus  @default(IN_PROGRESS)
  currentStepOrder Int                     @default(1) // hozir navbat qaysi bosqichda turibdi
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     WorkflowTemplate @relation(fields: [templateId], references: [id])
  initiator    User             @relation("WorkflowInitiator", fields: [initiatorUserId], references: [id])
  employee     Employee         @relation(fields: [employeeId], references: [id])
  stepActions  WorkflowStepAction[]
  attendanceCorrection AttendanceCorrection?

  @@index([organizationId])
  @@index([status])
  @@map("workflow_instances")
}

enum StepActionStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

// Har bir instance uchun har bir bosqichning haqiqiy natijasi —
// "kim, qachon, qanday qaror qildi" shu yerda ko'rinadi (kuzatuv ekrani shu yerdan o'qiydi)
model WorkflowStepAction {
  id           String            @id @default(cuid())
  instanceId   String
  stepId       String
  assignedUserId String? // qoida hisoblanib, kimga tayinlanganligi aniqlangach to'ldiriladi
  status       StepActionStatus  @default(PENDING)
  comment      String?
  actedAt      DateTime?
  createdAt    DateTime          @default(now())

  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step         WorkflowStep     @relation(fields: [stepId], references: [id])
  assignedUser User?            @relation(fields: [assignedUserId], references: [id])

  @@unique([instanceId, stepId])
  @@index([assignedUserId, status])
  @@map("workflow_step_actions")
}

// ==========================================================================
// AUDIT LOG
// ==========================================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // masalan: "employee.employment.changed"
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ==========================================================================
// NOTIFICATIONS — Employee Self-Service uchun minimal in-app bildirishnoma
// ==========================================================================

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  HR_MESSAGE
  DOCUMENT_AVAILABLE
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String // qabul qiluvchi
  type           NotificationType
  message        String
  entityType     String? // masalan "WorkflowInstance"
  entityId       String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId])
  @@map("notifications")
}

// ==========================================================================
// RECRUITMENT (ATS) — Faza 2
// ==========================================================================

enum VacancyStatus {
  OPEN
  ON_HOLD
  CLOSED
}

model Vacancy {
  id             String        @id @default(cuid())
  organizationId String
  departmentId   String?
  title          String
  description    String?
  status         VacancyStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidates   Candidate[]

  @@index([organizationId])
  @@map("vacancies")
}

// Kanban bosqichlari: yangi → skrining → intervyu → offer → ishga qabul / rad
enum CandidateStage {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Candidate {
  id             String         @id @default(cuid())
  organizationId String
  vacancyId      String
  fullName       String
  email          String?
  phone          String?
  resumeUrl      String?
  stage          CandidateStage @default(NEW)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vacancy      Vacancy      @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vacancyId, stage])
  @@map("candidates")
}

// ==========================================================================
// ATTENDANCE
//
// Muhim: bu modellar Employee/Department/Branch/User'ga hech qanday
// teskari relation qo'shmaydi (faqat employeeId: String — relation'siz).
// Bog'liqlik bir tomonlama: Attendance Core HR'ga tayanadi, Core HR
// Attendance haqida hech narsa bilmaydi. Xodim/bo'lim ma'lumoti kerak
// bo'lganda backend/src/modules/core-hr/employee.service.ts'dagi
// eksport qilingan funksiyalar orqali olinadi.
// ==========================================================================

// Tashkilot darajasidagi bitta standart ish vaqti konfiguratsiyasi —
// kechikish/overtime shunga nisbatan hisoblanadi.
model AttendanceSettings {
  id                   String   @id @default(cuid())
  organizationId       String   @unique
  standardStartTime    String   @default("09:00") // "HH:mm"
  standardEndTime      String   @default("18:00")
  standardWorkMinutes  Int      @default(480)
  lateThresholdMinutes Int      @default(10)
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("attendance_settings")
}

enum AttendanceSource {
  MANUAL // HR tabelchi qo'lda kiritgan
  DEVICE // kelajakda turniket/kamera integratsiyasi
  IMPORT // kelajakda fayl import
}

enum AttendanceDayStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  ON_LEAVE
  BUSINESS_TRIP
  REMOTE
  SICK
}

// Bir xodim, bir kun uchun bitta yozuv. Yozuv yo'qligi = ABSENT deb
// talqin qilinadi (agregatsiya vaqtida) — oldindan bo'sh yozuv
// yaratilmaydi (background job infratuzilmasi yo'q).
model AttendanceRecord {
  id                String              @id @default(cuid())
  organizationId    String
  employeeId        String
  date              DateTime            @db.Date
  checkInTime       DateTime?
  checkOutTime      DateTime?
  status            AttendanceDayStatus @default(PRESENT)
  source            AttendanceSource    @default(MANUAL)
  lateMinutes       Int                 @default(0)
  earlyLeaveMinutes Int                 @default(0)
  workedMinutes     Int                 @default(0)
  overtimeMinutes   Int                 @default(0)
  note              String?
  editedByUserId    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  corrections  AttendanceCorrection[]

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@index([employeeId, date])
  @@map("attendance_records")
}

enum CorrectionReasonType {
  DEVICE_FAILURE // "Turniket ishlamadi"
  WRONG_CHECK_IN // "Kirish vaqtim noto'g'ri"
  WRONG_CHECK_OUT // "Chiqish vaqtim noto'g'ri"
}

enum CorrectionStatus {
  PENDING_MANAGER // DIRECT_MANAGER bosqichida (Workflow Engine orqali)
  PENDING_TIMEKEEPER // ROLE:TIMEKEEPER bosqichida
  APPLIED // tasdiqlandi va AttendanceRecord avtomatik yangilandi
  REJECTED
}

// Xodim yuboradigan davomat tuzatish so'rovi. Tasdiqlash zanjiri
// Workflow Engine orqali (WorkflowInstance) — bu yerdagi status faqat
// Attendance nuqtai nazaridan qisqacha holatni ko'rsatadi.
model AttendanceCorrection {
  id                  String               @id @default(cuid())
  organizationId      String
  employeeId          String
  attendanceRecordId  String?
  date                DateTime             @db.Date
  reasonType          CorrectionReasonType
  requestedCheckIn    DateTime?
  requestedCheckOut   DateTime?
  comment             String?
  status              CorrectionStatus     @default(PENDING_MANAGER)
  workflowInstanceId  String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id])
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])

  @@index([organizationId, employeeId])
  @@index([status])
  @@map("attendance_corrections")
}

enum DepartmentTimesheetStatus {
  DRAFT // HR tabelchi shakllantirmoqda/tuzatmoqda
  DEPT_SUBMITTED // departament rahbariga yuborildi
  DEPT_APPROVED
  DEPT_REJECTED
  CONSOLIDATED // umumiy tabelga qo'shildi
}

// Bitta departament, bitta oy uchun tabel. Workflow Engine ishlatilmaydi —
// bu obyekt bitta xodimga emas, butun departamentga tegishli.
// Tabel katagiga qo'lda kiritilgan o'zgartirish (1-8 soat + izoh).
// Departament rahbari (yuborishdan oldin) yoki HR/tabelchi (tashkilot
// tabelida) kiritadi. Tabel yig'ilganda turniket ma'lumoti ustidan qo'llanadi.
model TimesheetCellEdit {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime @db.Date
  hours          Int
  comment        String
  editedByUserId String
  editedByRole   RoleName
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@map("timesheet_cell_edits")
}

model DepartmentTimesheet {
  id                   String                    @id @default(cuid())
  organizationId       String
  departmentId         String
  month                Int // 1-12
  year                 Int
  status               DepartmentTimesheetStatus @default(DRAFT)
  summaryData          Json // [{employeeId, presentDays, absentDays, lateDays, workedHours, overtimeHours}, ...]
  submittedAt          DateTime?
  deptApprovedByUserId String?
  deptApprovedAt       DateTime?
  rejectionComment     String?
  generatedByUserId    String
  // HR departament rahbari yubormasdan turib o'zi tasdiqlab o'tkazgan bo'lsa
  hrOverride           Boolean                   @default(false)
  hrOverrideReason     String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgTimesheetLines OrganizationTimesheetLine[]

  @@unique([organizationId, departmentId, year, month])
  @@index([organizationId, year, month])
  @@map("department_timesheets")
}

enum OrganizationTimesheetStatus {
  DRAFT
  SUBMITTED // yuqori rahbarga (SUPER_ADMIN) yuborildi
  APPROVED // FINAL
  REJECTED
}

// Bir nechta DEPT_APPROVED DepartmentTimesheet'larni birlashtiruvchi,
// tashkilot darajasidagi yakuniy tabel.
model OrganizationTimesheet {
  id                   String                      @id @default(cuid())
  organizationId       String
  month                Int
  year                 Int
  status               OrganizationTimesheetStatus @default(DRAFT)
  consolidatedByUserId String
  submittedAt          DateTime?
  approvedByUserId     String?
  approvedAt           DateTime?
  rejectionComment     String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        OrganizationTimesheetLine[]

  @@unique([organizationId, year, month])
  @@map("organization_timesheets")
}

model OrganizationTimesheetLine {
  id                      String @id @default(cuid())
  organizationTimesheetId String
  departmentTimesheetId   String

  organizationTimesheet OrganizationTimesheet @relation(fields: [organizationTimesheetId], references: [id], onDelete: Cascade)
  departmentTimesheet   DepartmentTimesheet   @relation(fields: [departmentTimesheetId], references: [id])

  @@unique([organizationTimesheetId, departmentTimesheetId])
  @@map("organization_timesheet_lines")
}
